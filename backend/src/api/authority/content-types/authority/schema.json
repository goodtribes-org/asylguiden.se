{
  "kind": "collectionType",
  "collectionName": "authorities",
  "info": {
    "singularName": "authority",
    "pluralName": "authorities",
    "displayName": "Authority",
    "description": "An authority, bank, healthcare provider or organisation a guide step points to"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "government",
        "municipality",
        "bank",
        "ngo",
        "healthcare"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "whatTheyDo": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "website": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "phone": {
      "type": "string",
      "description": "Verify against the authority's own site before publishing. Never guess.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "interpreterAvailable": {
      "type": "boolean",
      "description": "Whether an interpreter can be arranged for a visit or call.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "languagesSupported": {
      "type": "json",
      "description": "Locale codes the authority serves directly, e.g. [\"sv\",\"en\",\"ar\"].",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "bookingRequired": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "offices": {
      "type": "component",
      "repeatable": true,
      "component": "shared.office",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "provenance": {
      "type": "component",
      "repeatable": false,
      "component": "shared.provenance",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
