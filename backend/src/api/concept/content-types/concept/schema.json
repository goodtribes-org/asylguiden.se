{
  "kind": "collectionType",
  "collectionName": "concepts",
  "info": {
    "singularName": "concept",
    "pluralName": "concepts",
    "displayName": "Concept",
    "description": "A term explainer — its own linkable, searchable unit"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "term": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "term",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "shortDefinition": {
      "type": "text",
      "required": true,
      "description": "One sentence. Rendered in tooltips by #32 — an empty value is a tooltip that explains nothing.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "explanation": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "whyYouNeedIt": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "aliases": {
      "type": "json",
      "description": "Alternative spellings and phrasings for search. Localized — spelling variants differ per language.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "relatedConcepts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::concept.concept",
      "description": "Unidirectional on purpose. A self-referential manyToMany needs either two attributes (an owning side plus an inverse) or neither; `inversedBy: relatedConcepts` pointing at itself only warns, and `mappedBy: relatedConcepts` leaves no owning side and breaks writes with 'Cannot read properties of undefined (reading joinColumn)'.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "provenance": {
      "type": "component",
      "repeatable": false,
      "component": "shared.provenance",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
